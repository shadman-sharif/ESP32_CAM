/*
  ESP32-CAM Basic Test
  --------------------
  Purpose:
  1. Check that the ESP32-CAM starts correctly
  2. Check Serial Monitor communication
  3. Print a message every second
*/

void setup() {
  Serial.begin(115200);

  delay(1000);

  Serial.println();
  Serial.println("==========================");
  Serial.println("   ESP32-CAM TEST");
  Serial.println("==========================");
  Serial.println("ESP32-CAM started!");
}

void loop() {
  Serial.println("ESP32-CAM is running...");
  delay(1000);
}
